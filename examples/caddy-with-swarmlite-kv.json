{
  "admin": {
    "listen": "0.0.0.0:2019",
    "config": {
      "persist": true
    }
  },
  "storage": {
    "module": "swarmlite",
    "controller": "http://10.0.0.21:17080",
    "token_env": "SWARMLITE_TOKEN",
    "gateway_id_env": "SWARMLITE_GATEWAY_ID",
    "timeout": "500ms",
    "probe_timeout": "2s",
    "owner_cache_ttl": "1m",
    "lock_lease": "30s"
  },
  "apps": {
    "http": {
      "servers": {
        "swarmlite": {
          "listen": [":80"],
          "routes": [
            {
              "@id": "swarmlite-gateway-owner-probe",
              "match": [
                {
                  "protocol": "http",
                  "path_regexp": {
                    "pattern": "^/\\.well-known/swarmlite/gateway-owner$"
                  }
                }
              ],
              "handle": [
                { "handler": "swarmlite_gateway_probe" }
              ],
              "terminal": true
            }
          ]
        }
      }
    }
  }
}
