[Unit]
Description=Swarmlite node service
Documentation=https://github.com/gfreezy/swarmlite
Wants=network-online.target
After=network-online.target docker.service podman.socket
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/swarmlite/runtime.env
ExecStart=/usr/local/bin/swarmlite --data-dir /var/lib/swarmlite serve --runtime ${SWARMLITE_RUNTIME} --runtime-socket ${SWARMLITE_RUNTIME_SOCKET}
Restart=always
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=30s
StateDirectory=swarmlite
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
