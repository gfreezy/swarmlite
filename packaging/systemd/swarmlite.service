[Unit]
Description=Swarmlite node service
Documentation=https://github.com/gfreezy/swarmlite
Wants=network-online.target
After=network-online.target docker.service podman.socket
ConditionPathExists=/var/lib/swarmlite/swarmlite.sqlite
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/swarmlite/runtime.env
ExecStart=/usr/local/bin/swarmlite serve
Restart=always
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=30s
StateDirectory=swarmlite
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
